# New Node store database (clean schema)
DATABASE_URL="mysql://root:@localhost:3306/custom_ecommerce"

PORT=4000
# Public URL of this API (used for media URLs and links)
SITE_URL="http://localhost:4000"
# Comma-separated list of allowed frontend origins ("*" = any)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# JWT for customer/admin login (/wp-json/jwt-auth/v1/token)
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Cache TTL (seconds) for public GET responses; 0 = disabled
CACHE_TTL=60

# --- Old WordPress database (only needed for `npm run migrate:wp`) ---
WP_DB_HOST=localhost
WP_DB_PORT=3306
WP_DB_USER=root
WP_DB_PASSWORD=
WP_DB_NAME=wordpress
WP_TABLE_PREFIX=wp_
# Old site's uploads URL, used to rewrite media links
WP_UPLOADS_URL="https://old-site.com/wp-content/uploads"

# Public storefront URL (your React app) — used for permalinks in API responses
FRONTEND_URL="http://localhost:3000"
# Allow unauthenticated GET on products/categories/tags/attributes/reviews
PUBLIC_CATALOG=true
